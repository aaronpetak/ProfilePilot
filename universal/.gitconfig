# Personal identity (user.name / user.email) is written by bootstrap.sh to
# ~/.gitconfig.local. This include must stay at the TOP so the per-directory
# identities below, which come later, override it.
[include]
    path = ~/.gitconfig.local

[includeIf "gitdir:~/projects/github/"]
    path = ~/projects/github/.gitconfig

[includeIf "gitdir:~/projects/ghe/"]
    path = ~/projects/ghe/.gitconfig

[commit]
    template = ~/.gitmessage

[init]
    defaultBranch = main
