# .shell_aliases — shared aliases and helper functions for all shells/profiles.
#
# This single file is sourced by both bash (.bashrc) and zsh (.zshrc) on every
# OS and profile. There is intentionally no per-OS or per-profile copy: keep
# everything portable here and guard anything tool-specific so it silently
# self-disables when the tool (or the OS feature) is absent. That way the
# minimal profile can source the exact same file as the developer profile.

# Make it easy to view the configured aliases (works regardless of shell).
alias aa='cat ~/.shell_aliases'

###############################################################################
# Portable `ls` colors
###############################################################################
# GNU coreutils `ls` uses --color=auto; BSD/macOS `ls` uses -G and errors on
# --color. Detect which one is on PATH and define the listing aliases with the
# right color flag so they work identically everywhere.
if ls --color=auto >/dev/null 2>&1; then
    # GNU coreutils
    alias ls='ls -F --color=auto'
    alias ll='ls -lF --color=auto'
    alias la='ls -alF --color=auto'
else
    # BSD / macOS
    alias ls='ls -F -G'
    alias ll='ls -lF -G'
    alias la='ls -alF -G'
fi

# Highlight grep matches and skip .svn dirs.
alias grep='grep --color=auto --exclude-dir=\.svn'

# Print $PATH one entry per line.
alias path='tr ":" "\n" <<< "$PATH"'

###############################################################################
# Safer file operations
###############################################################################
alias rm='rm -i'
alias mv='mv -i'
alias cp='cp -i'

###############################################################################
# Git (only if git is installed)
###############################################################################
# An older alias named get would be expanded while the function below is parsed
# (breaking its definition), so remove it before the guarded block is read.
unalias get 2>/dev/null
if command -v git >/dev/null 2>&1; then
    # Most commonly used
    alias gco='git checkout'
    alias glo='git log --oneline --abbrev-commit --graph --decorate --color'
    alias gst='git status'
    alias gsw='git switch'
    alias new='git checkout -b'
    alias yolo='git push origin --force-with-lease'
    alias grpo='git remote prune origin'

    # Less commonly used
    alias grc='git rebase --continue'
    alias grs='git rebase --skip'
    alias gsb='git branch --verbose'
    alias recommit='git commit --amend --no-edit'
    alias uncommit='git reset --soft HEAD~1'
    alias unstage='git reset HEAD --'
    alias yeet='git push origin HEAD'

    # Pull origin's default branch, whatever it is called. origin/HEAD is
    # normally set by `git clone`; when it is missing (e.g. a repo made with
    # `git init` + `git remote add`), ask the remote once to set it. Extra
    # arguments are passed to `git pull`.
    get() {
        local b
        b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
        if [ -z "$b" ]; then
            git remote set-head origin --auto >/dev/null 2>&1
            b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
        fi
        if [ -z "$b" ]; then
            echo "get: cannot determine origin's default branch (is there an origin remote?)." >&2
            return 1
        fi
        git pull origin "${b#origin/}" "$@"
    }
fi

###############################################################################
# Helper functions
###############################################################################
# Make a directory (and parents) and cd into it.
mkcd() {
    mkdir -p "$@" && cd "${@: -1}" || return
}

# Create a virtualenv for the current directory (needs virtualenvwrapper).
# A function that checks for mkvirtualenv when it runs, not when this file is
# sourced: virtualenvwrapper is usually loaded later (by the developer add-on),
# so a source-time check would never see it. Extra arguments (e.g. the env name)
# are passed through. Any older alias of the same name is removed first, since
# an alias would shadow, or break the definition of, the function.
unalias here 2>/dev/null
here() {
    if ! command -v mkvirtualenv >/dev/null 2>&1; then
        echo "here: mkvirtualenv not found (install virtualenvwrapper and load virtualenvwrapper.sh)." >&2
        return 1
    fi
    mkvirtualenv -a "$(pwd)" "$@"
}

# Populate a Terraform directory with the standard file layout (needs terraform).
# Defined unconditionally and checked at call time, like `here` above.
tf_init() {
    local dir_name
    if ! command -v terraform >/dev/null 2>&1; then
        echo "tf_init: terraform not found on PATH." >&2
        return 1
    fi
    dir_name=$(basename "$PWD")
    touch backend.tf main.tf variables.tf outputs.tf providers.tf locals.tf terraform.tf
    # Only write the README skeleton when there is none; never overwrite one.
    if [ ! -e README.md ]; then
        cat > README.md <<EOF
# $dir_name

<!-- BEGIN_TF_DOCS -->
<!-- END_TF_DOCS -->

EOF
    fi
    echo "Terraform files created in $dir_name."
}
